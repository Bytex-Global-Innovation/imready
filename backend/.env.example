# Server
# API routes are served under /api/v1 (e.g. /api/v1/auth/students/login)
# Health: GET /api/v1/health  |  Uploads: /uploads/*
NODE_ENV=
PORT=

# CORS — comma-separated origins (must include student frontend for cookie auth)
CORS_ORIGINS=

# Student frontend URL (verification / reset email links) — NOT the admin app.
# Local defaults: student http://localhost:3000 , admin http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Premium UPI payment (also set NEXT_PUBLIC_* on the student frontend)
# PREMIUM_UPI_ID=imready@upi
# PREMIUM_AMOUNT=999

# JWT — must be at least 32 characters
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_ISSUER=  
JWT_STUDENT_ISSUER=

# Short-lived access token (httpOnly cookie)
JWT_STUDENT_ACCESS_EXPIRES_IN=

# Admin access token (httpOnly cookie) — hard logout after expiry
JWT_ADMIN_ACCESS_EXPIRES_IN=


ADMIN_EMAIL=
ADMIN_PASSWORD=

# MySQL
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=

# Email — default provider is AWS SES (verification + password reset)
MAIL_PROVIDER=ses
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Verified sender in SES (e.g. "ImReady <no-reply@yourdomain.com>")
SES_FROM=

# Optional legacy SMTP (set MAIL_PROVIDER=smtp to use Gmail or other SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
