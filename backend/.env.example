# Server
NODE_ENV=
PORT=

# CORS — comma-separated origins
CORS_ORIGINS=

# JWT — must be at least 32 characters
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_ISSUER=

# Seeded by `npm run migration:run` (login uses DB only) 
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# MySQL
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=
