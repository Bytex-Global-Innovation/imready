# =============================================================================
# Docker Compose configuration for IMReady
#
# Copy this file to `.env` (same folder as docker-compose.yml) and fill in
# real values before running `docker compose up -d --build`.
#
# NOTE on NEXT_PUBLIC_* vars: Next.js inlines them into the client bundle at
# BUILD time. If you change them after the images were built, you must
# rebuild (`docker compose build admin frontend`) for the change to apply.
# =============================================================================

# ----------------------------- Host ports (local dev: docker-compose.yml) ---
FRONTEND_PORT=3000
ADMIN_PORT=3001
BACKEND_PORT=4000
DB_PORT=3306

# Production (docker-compose.prod.yml) — bind to localhost only; Nginx proxies in
# VERIFY these ports are free on the VPS before deploy (ss -tlnp)
IMREADY_FRONTEND_PORT=13000
IMREADY_ADMIN_PORT=13001
IMREADY_BACKEND_PORT=14000
IMREADY_UPLOADS_DIR=/srv/imready/uploads
IMREADY_MYSQL_DATA_DIR=/srv/imready/mysql

# ------------------------------- MySQL ---------------------------------------
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_NAME=imready
DB_USER=imready
DB_PASSWORD=change_me_password
DB_CONNECTION_LIMIT=10

# --------------------------- Backend (Express API) ---------------------------
NODE_ENV=production

# Comma-separated list of origins allowed to call the API with credentials.
# Must include both the student frontend and the admin panel origins.
# Production example:
# CORS_ORIGINS=https://imready.in,https://admin.imready.in
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Student frontend URL for verification / password-reset emails.
# Must be the student app, never the admin panel.
# Production example: FRONTEND_URL=https://imready.in
FRONTEND_URL=http://localhost:3000

# Must be at least 32 characters.
JWT_SECRET=change_me_to_a_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=1d
JWT_ISSUER=imready-admin
JWT_STUDENT_ISSUER=imready-student
JWT_STUDENT_ACCESS_EXPIRES_IN=15m
JWT_ADMIN_ACCESS_EXPIRES_IN=1d

# Bootstrap admin account, created automatically on first backend start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# Email (backend) — AWS SES by default
MAIL_PROVIDER=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM=

# Legacy SMTP fallback (MAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ------------------------ Next.js apps (build-time) ---------------------------
# Production example: https://api.imready.in/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_USE_MOCK=false

# Optional frontend premium UPI display (student app)
# NEXT_PUBLIC_PREMIUM_AMOUNT=999
# NEXT_PUBLIC_PREMIUM_UPI_ID=your-upi@bank
# NEXT_PUBLIC_PREMIUM_PAYEE_NAME=ImReady
